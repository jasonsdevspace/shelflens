{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "jsx": "react-jsx",
        "types": ["vite/client", "node"],
        // The pages and the service worker are checked as one project, and the web worker's
        // declarations the service worker loads give some of the DOM's globals other types. Apart
        // from the worker, jest-dom's matchers for Vitest and Lighthouse's trace engine declare
        // types their own dependencies disagree with, so declaration files are left unchecked.
        "skipLibCheck": true,
        "noEmit": true,
        "customConditions": ["@shelflens/source"]
    },
    "include": [
        "src",
        "e2e",
        "vite.config.ts",
        "vite.sw.config.ts",
        "vite.widget.config.ts",
        "vitest.setup.ts",
        "playwright.config.ts"
    ]
}
