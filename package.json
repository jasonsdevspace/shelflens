{
    "name": "shelflens",
    "version": "0.1.0",
    "private": true,
    "description": "A product search experience for a fictional store, and the search engine behind it.",
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "type-check": "npm run type-check --workspaces",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prose": "node scripts/check-prose.mjs",
        "test": "vitest",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage",
        "build": "npm run build --workspaces --if-present",
        "catalog": "tsx packages/catalog/src/cli.ts",
        "bench": "npm run build && NODE_OPTIONS=--expose-gc tsx packages/search/src/bench-cli.ts && prettier --write docs/benchmarks",
        "api": "npm run build && node packages/server/dist/main.js",
        "codegen": "graphql-codegen --config packages/api/codegen.mjs && node packages/api/scripts/inline-schema.mjs && prettier --write packages/api/src/generated",
        "verify": "npm run type-check && npm run lint && npm run format:check && npm run prose && npm run test:run",
        "prepare": "husky || true"
    },
    "license": "MIT",
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@graphql-codegen/cli": "^7.4.6",
        "@graphql-codegen/typescript": "^6.1.2",
        "@graphql-codegen/typescript-resolvers": "^6.1.1",
        "@types/node": "26.6.5",
        "@vitest/coverage-v8": "5.0.5",
        "esbuild": "^0.28.2",
        "eslint": "10.13.0",
        "eslint-plugin-import-x": "^4.17.1",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "eslint-plugin-sonarjs": "^4.2.2",
        "globals": "17.13.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "prettier": "3.9.10",
        "tsx": "4.23.15",
        "typescript": "6.0.3",
        "typescript-eslint": "8.72.1",
        "vitest": "5.0.5"
    },
    "lint-staged": {
        "*.{ts,tsx,js,mjs}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,yml,yaml,css,html,graphql}": [
            "prettier --write"
        ]
    }
}
