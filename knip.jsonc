{
    // Nothing is exported, or depended on, that nothing uses. Run in verify and in CI
    // as `knip --tsConfig tsconfig.build.json`.
    //
    // Each workspace names the files something runs directly. The private
    // packages' entries count, so an export no other package imports is
    // found, and the published engine's entry is its public API, so it does not.
    // Each package's build config says where its build writes, so a package's
    // dist maps back to its source and this runs before anything is built. The
    // storefront and the root build nothing another package imports, so their
    // files are read as they are.
    "$schema": "https://unpkg.com/knip@6.43.0/schema.json",
    // What it reports: exports and types nothing imports, a thing exported twice, and
    // dependencies nothing uses, that something uses unlisted, or that do not resolve.
    "include": [
        "exports",
        "types",
        "nsExports",
        "nsTypes",
        "duplicates",
        "dependencies",
        "unlisted",
        "binaries",
        "unresolved",
    ],
    // Written by codegen in full, whatever the operations use.
    "ignore": ["**/src/generated/**"],
    "ignoreIssues": {
        // Read by Vite, which loads each config's default export.
        "apps/storefront/vite*.config.ts": ["exports"],
        // Loaded by the shell plugin through Vite, by path, so no import names it.
        "apps/storefront/src/app/shell.tsx": ["exports"],
    },
    "workspaces": {
        ".": { "entry": ["scripts/*.mjs"] },
        "packages/engine": { "entry": ["smoke/**/*.{ts,mjs}"] },
        "packages/api": { "includeEntryExports": true, "entry": ["scripts/*.mjs"] },
        "packages/catalog": { "includeEntryExports": true, "entry": ["src/cli.ts"] },
        "packages/search": { "includeEntryExports": true, "entry": ["src/bench-cli.ts"] },
        "apps/server": { "includeEntryExports": true, "entry": ["src/main.ts"] },
        "apps/storefront": {
            "includeEntryExports": true,
            // Its configs load the dev server's plugins from built packages, so
            // the pages, the widget and the worker are named here instead.
            "vite": false,
            "entry": [
                "src/main.tsx",
                "src/about/main.ts",
                "src/try/main.tsx",
                "src/widget/demo.tsx",
                "src/widget/index.tsx",
                "src/worker/sw.ts",
                "src/try/cli.ts",
                "src/bench/*.ts",
                "e2e/**/*.ts",
                "vite*.config.ts",
            ],
        },
    },
}
