{
    "name": "@shelflens/api",
    "version": "0.1.0",
    "private": true,
    "description": "The store's GraphQL search API: the schema, and the resolvers over @shelflens/search.",
    "license": "MIT",
    "type": "module",
    "exports": {
        ".": {
            "@shelflens/source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "sideEffects": false,
    "scripts": {
        "type-check": "tsc -p tsconfig.json",
        "build": "tsc -b tsconfig.build.json"
    },
    "dependencies": {
        "@jasonsdevspace/shelflens": "*",
        "@shelflens/catalog": "0.1.0",
        "@shelflens/search": "0.1.0",
        "graphql": "17.0.2"
    }
}
