{
    "name": "@jasonsdevspace/shelflens",
    "version": "0.5.0",
    "description": "A product search engine with typo tolerance, synonyms, facets, merchandising rules and an explanation for every result. No dependencies, runs anywhere JavaScript does.",
    "keywords": [
        "search",
        "full-text",
        "fuzzy-search",
        "typo-tolerance",
        "synonyms",
        "facets",
        "merchandising",
        "ecommerce"
    ],
    "homepage": "https://github.com/jasonsdevspace/shelflens/tree/main/packages/engine#readme",
    "bugs": {
        "url": "https://github.com/jasonsdevspace/shelflens/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jasonsdevspace/shelflens.git",
        "directory": "packages/engine"
    },
    "license": "MIT",
    "author": "Jason Poteet",
    "type": "module",
    "exports": {
        ".": {
            "@shelflens/source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist",
        "src",
        "!src/**/*.test.ts",
        "CHANGELOG.md"
    ],
    "sideEffects": false,
    "engines": {
        "node": ">=22"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "type-check": "tsc -p tsconfig.json && tsc -p smoke",
        "build": "tsc -b tsconfig.build.json",
        "prepack": "npm run build"
    }
}
