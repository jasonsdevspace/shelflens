{
    "name": "@jasonsdevspace/shelflens",
    "version": "0.1.0",
    "private": true,
    "description": "A product search engine with typo tolerance, synonyms, facets, merchandising rules and an explanation for every result. No dependencies, runs anywhere JavaScript does.",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "sideEffects": false,
    "scripts": {
        "type-check": "tsc -p tsconfig.json",
        "build": "tsc -b tsconfig.build.json"
    },
    "keywords": [
        "search",
        "full-text",
        "facets",
        "typo-tolerance",
        "ecommerce"
    ],
    "license": "MIT"
}
