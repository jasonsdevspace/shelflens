{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "jsx": "react-jsx",
        "types": ["vite/client", "node"],
        "noEmit": true,
        "paths": {
            "@shelflens/catalog": ["../catalog/src/index.ts"],
            "@jasonsdevspace/shelflens": ["../engine/src/index.ts"],
            "@shelflens/search": ["../search/src/index.ts"],
            "@shelflens/api": ["../api/src/index.ts"],
            "@shelflens/server": ["../server/src/index.ts"]
        }
    },
    "include": [
        "src",
        "e2e",
        "vite.config.ts",
        "vite.sw.config.ts",
        "vitest.setup.ts",
        "playwright.config.ts"
    ]
}
